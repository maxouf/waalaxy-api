# Copier dans ~/.config/waalaxy/api.env puis : chmod 600 ~/.config/waalaxy/api.env
# Jeton du mode cloud (voir README) — sans expiration, valable jusqu'a deconnexion de Waalaxy
WAALAXY_TOKEN=
# Optionnel : deduit du jeton s'il manque
# WAALAXY_USER_ID=
# Optionnel : passerelle (valeur par defaut)
# WAALAXY_API_URL=https://stargate.prod.aws.waalaxy.com/api
